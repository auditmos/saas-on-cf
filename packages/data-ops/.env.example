# Drizzle / Neon credentials — read by drizzle-{dev,staging,production}.config.ts
# and seed scripts via `dotenvx run -f .env.{dev,staging,production}`.
# Application runtime vars (BETTER_AUTH_*, API_TOKEN, etc.) live in the consuming
# Worker's .dev.vars / .{staging,production}.vars — not here.
DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=
