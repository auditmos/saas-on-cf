{
	"name": "saas-on-cf",
	"version": "0.0.0",
	"description": "",
	"scripts": {
		"prepare": "simple-git-hooks",
		"setup": "pnpm i && pnpm run build:data-ops",
		"build:data-ops": "pnpm run --filter data-ops build",
		"dev:user-application": "pnpm run --filter user-application dev",
		"deploy:staging:user-application": "pnpm run build:data-ops && pnpm run --filter user-application deploy:staging",
		"deploy:production:user-application": "pnpm run build:data-ops && pnpm run --filter user-application deploy:production",
		"dev:data-service": "pnpm run --filter data-service dev",
		"deploy:staging:data-service": "pnpm run build:data-ops && pnpm run --filter data-service deploy:staging",
		"deploy:production:data-service": "pnpm run build:data-ops && pnpm run --filter data-service deploy:production",
		"db:generate:dev": "pnpm run --filter data-ops db:generate:dev",
		"db:generate:staging": "pnpm run --filter data-ops db:generate:staging",
		"db:generate:production": "pnpm run --filter data-ops db:generate:production",
		"db:migrate:dev": "pnpm run --filter data-ops db:migrate:dev",
		"db:migrate:staging": "pnpm run --filter data-ops db:migrate:staging",
		"db:migrate:production": "pnpm run --filter data-ops db:migrate:production",
		"db:pull:dev": "pnpm run --filter data-ops db:pull:dev",
		"db:pull:staging": "pnpm run --filter data-ops db:pull:staging",
		"db:pull:production": "pnpm run --filter data-ops db:pull:production",
		"db:studio": "pnpm run --filter data-ops db:studio",
		"db:seed:dev": "pnpm run --filter data-ops db:seed:dev",
		"db:seed:staging": "pnpm run --filter data-ops db:seed:staging",
		"db:seed:production": "pnpm run --filter data-ops db:seed:production",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ci": "biome ci .",
		"types": "pnpm run build:data-ops && pnpm run --filter data-service --filter user-application types",
		"init-project": "tsx scripts/init-project.ts",
		"knip": "knip",
		"deps": "taze -r",
		"deps:update": "taze -r -w",
		"deps:major": "taze -r major",
		"deps:major:update": "taze -r major -w",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.34.5",
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@types/node": "^22.20.1",
		"@vitest/coverage-v8": "^4.1.10",
		"knip": "^6.27.0",
		"semantic-release": "^25.0.8",
		"simple-git-hooks": "^2.13.1",
		"taze": "^19.16.0",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint:ci",
		"pre-push": "pnpm run types && pnpm run knip"
	}
}
