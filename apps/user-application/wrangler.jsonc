{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "saas-on-cf-ua",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	"main": "./src/server.ts",
	"services": [
		{
			"binding": "DATA_SERVICE",
			"service": "saas-on-cf-ds-dev"
		}
	],
	"env": {
		/**
		 * Local / Development environment
		 */
		"dev": {
			"name": "saas-on-cf-ua-dev",
			"vars": { "CLOUDFLARE_ENV": "dev" },
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "saas-on-cf-ds-dev"
				}
			]
		},
		/**
		 * Remote / Staging environment
		 */
		"staging": {
			"name": "saas-on-cf-ua-staging",
			"vars": { "CLOUDFLARE_ENV": "staging" },
			// "routes": [
			//   {
			//     "custom_domain": true,
			//     "pattern": "staging.YOUR_DOMAIN.COM"
			//   }
			// ],
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "saas-on-cf-ds-staging"
				}
			]
		},
		/**
		 * Remote / Production environment
		 */
		"production": {
			"name": "saas-on-cf-ua-production",
			"vars": { "CLOUDFLARE_ENV": "production" },
			// "routes": [
			//   {
			//     "custom_domain": true,
			//     "pattern": "YOUR_DOMAIN.COM"
			//   }
			// ],
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "saas-on-cf-ds-production"
				}
			]
		}
	}
}
