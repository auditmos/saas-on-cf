{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "saas-on-cf-ua",
	"compatibility_date": "2026-05-25",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
		"logs": { "head_sampling_rate": 1 },
		"traces": { "enabled": true, "head_sampling_rate": 0.01 }
	},
	"main": "./src/server.ts",
	"services": [
		{
			"binding": "DATA_SERVICE",
			"service": "saas-on-cf-ds-dev"
		}
	],
	// Thresholds mirror RATE_LIMIT_POLICY in @repo/data-ops/rate-limit, which is
	// where they are decided. `scripts/rate-limit-policy.test.ts` fails if the two
	// disagree. Declared per env because `ratelimits` is not inherited.
	"ratelimits": [
		{
			"name": "RATE_LIMITER_SERVER_FN",
			"namespace_id": "2000",
			"simple": { "limit": 100, "period": 60 }
		}
	],
	"env": {
		/**
		 * Local / Development environment
		 */
		"dev": {
			"name": "saas-on-cf-ua-dev",
			"vars": { "CLOUDFLARE_ENV": "dev" },
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "saas-on-cf-ds-dev"
				}
			],
			// Thresholds mirror RATE_LIMIT_POLICY in @repo/data-ops/rate-limit, which is
			// where they are decided. `scripts/rate-limit-policy.test.ts` fails if the two
			// disagree. Declared per env because `ratelimits` is not inherited.
			"ratelimits": [
				{
					"name": "RATE_LIMITER_SERVER_FN",
					"namespace_id": "2001",
					"simple": { "limit": 100, "period": 60 }
				}
			]
		},
		/**
		 * Remote / Staging environment
		 */
		"staging": {
			"name": "saas-on-cf-ua-staging",
			"vars": { "CLOUDFLARE_ENV": "staging" },
			// "routes": [
			//   {
			//     "custom_domain": true,
			//     "pattern": "staging.YOUR_DOMAIN.COM"
			//   }
			// ],
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "saas-on-cf-ds-staging"
				}
			],
			// Thresholds mirror RATE_LIMIT_POLICY in @repo/data-ops/rate-limit, which is
			// where they are decided. `scripts/rate-limit-policy.test.ts` fails if the two
			// disagree. Declared per env because `ratelimits` is not inherited.
			"ratelimits": [
				{
					"name": "RATE_LIMITER_SERVER_FN",
					"namespace_id": "2002",
					"simple": { "limit": 100, "period": 60 }
				}
			]
		},
		/**
		 * Remote / Production environment
		 */
		"production": {
			"name": "saas-on-cf-ua-production",
			"vars": { "CLOUDFLARE_ENV": "production" },
			// "routes": [
			//   {
			//     "custom_domain": true,
			//     "pattern": "YOUR_DOMAIN.COM"
			//   }
			// ],
			"services": [
				{
					"binding": "DATA_SERVICE",
					"service": "saas-on-cf-ds-production"
				}
			],
			// Thresholds mirror RATE_LIMIT_POLICY in @repo/data-ops/rate-limit, which is
			// where they are decided. `scripts/rate-limit-policy.test.ts` fails if the two
			// disagree. Declared per env because `ratelimits` is not inherited.
			"ratelimits": [
				{
					"name": "RATE_LIMITER_SERVER_FN",
					"namespace_id": "2003",
					"simple": { "limit": 100, "period": 60 }
				}
			]
		}
	}
}
