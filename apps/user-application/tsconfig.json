{
	"include": ["**/*.ts", "**/*.tsx"],
	"compilerOptions": {
		"noUncheckedIndexedAccess": true,
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "vitest/globals"],

		/* Bundler mode */
		"moduleResolution": "bundler",
		/* Resolve @repo/data-ops to its source, so a schema edit is visible here
		   without a rebuild. Only TypeScript applies this condition — Vite and
		   the deploy fall through to `default` and still take dist/. */
		"customConditions": ["@repo/source"],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,

		/* Linting */
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
