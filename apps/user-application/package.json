{
	"name": "user-application",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"build:staging": "vite build --mode staging",
		"build:production": "vite build --mode production",
		"deploy:staging": "pnpm run build:staging && wrangler deploy --env=''",
		"deploy:production": "pnpm run build:production && wrangler deploy --env=''",
		"serve": "vite preview",
		"cf-typegen": "wrangler types --env-interface BaseEnv --env dev",
		"types": "tsc --noEmit",
		"test": "vitest run && vitest run --config vitest.workers.config.mts",
		"test:watch": "vitest",
		"test:watch:workers": "vitest --config vitest.workers.config.mts"
	},
	"packageManager": "pnpm@12.14.0",
	"dependencies": {
		"@radix-ui/react-avatar": "^1.3.1",
		"@radix-ui/react-collapsible": "^1.2.1",
		"@radix-ui/react-dialog": "^1.3.1",
		"@radix-ui/react-dropdown-menu": "^2.2.1",
		"@radix-ui/react-scroll-area": "^1.4.0",
		"@radix-ui/react-slot": "^1.5.0",
		"@repo/data-ops": "workspace:^",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.4",
		"@tanstack/react-query-devtools": "^5.104.4",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.169.3",
		"better-auth": "^1.7.10",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.59.0",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-icons": "^5.7.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.64.0",
		"@cloudflare/vitest-plugin": "^1.4.4",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^4.1.12",
		"web-vitals": "^6.2.3",
		"wrangler": "^4.151.1"
	}
}
