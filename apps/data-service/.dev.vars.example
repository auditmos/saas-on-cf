# CLOUDFLARE_ENV is declared in wrangler.jsonc vars per env block — do not duplicate it here.

DATABASE_HOST=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Service-to-service bearer. Must equal DATA_SERVICE_API_TOKEN in user-application,
# which sends it over the service binding. Browsers authenticate with the session cookie.
API_TOKEN=

# Comma-separated list of allowed origins for CORS. Ignored in dev, which allows
# http://localhost:3000 and http://127.0.0.1:3000 only.
ALLOWED_ORIGINS=
