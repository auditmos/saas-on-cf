{
	"name": "data-service",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy:staging": "wrangler deploy --env staging",
		"deploy:production": "wrangler deploy --env production",
		"dev": "wrangler dev --env dev --port 8788",
		"cf-typegen": "wrangler types --env-interface BaseEnv --env dev",
		"types": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"packageManager": "pnpm@12.9.1",
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.3.6",
		"@types/node": "^24.19.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"@repo/data-ops": "workspace:*",
		"hono": "^4.13.13"
	}
}
